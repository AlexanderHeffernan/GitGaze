{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "GitGaze",
  "mainBinaryName": "GitGaze",
  "version": "1.1.0",
  "identifier": "app.gitbar.mac",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "popover",
        "title": "GitGaze",
        "url": "index.html",
        "width": 384,
        "height": 640,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "celebration",
        "title": "GitGaze celebration",
        "url": "celebration.html",
        "width": 440,
        "height": 340,
        "visible": false,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "focus": false,
        "focusable": false,
        "shadow": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: https://avatars.githubusercontent.com; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "category": "DeveloperTool",
    "shortDescription": "Your GitHub momentum, in your menu bar.",
    "copyright": "MIT licence",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "installMode": "currentUser",
        "startMenuFolder": "GitGaze"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IEdpdEdhemUgdXBkYXRlIGtleSA1RENEMzM4MEI5MzkwNTU2ClJXUmR6VE9BdVRrRlZoZHRid3dBZU9pb0lTSjJlYVV1Wm14V09jVllYbUlQMCtweStJaHNVOHZwCg==",
      "endpoints": ["https://github.com/AlexanderHeffernan/GitGaze/releases/latest/download/latest.json"],
      "requireSignedVersion": true,
      "windows": { "installMode": "passive" }
    }
  }
}
